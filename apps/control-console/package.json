{
  "name": "@luminaryworks/control-console",
  "version": "0.1.0",
  "private": true,
  "license": "Polyform-Noncommercial-1.0.0",
  "description": "LuminaryWorks central superadmin control console (not Logto Admin)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src server vite.config.ts",
    "test": "vitest run && node --test server/*.test.mjs",
    "start": "node server/main.mjs",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@luminaryworks/auth-react": "^0.4.2",
    "fastify": "5.11.3",
    "i18next": "^24.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@luminaryworks/auth-dev-proxy": "^0.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "5.9.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
