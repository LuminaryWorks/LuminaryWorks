# Runtime config for the Control Console. Copy to `.env` for Vite dev.
# Never put client secrets, service keys, or payment credentials here.

CONTROL_CONSOLE_PORT=3050
# Prefer opening the SAME host as this URL (localhost and 127.0.0.1 are both registered).
# Dev proxy rewrites OIDC discovery using the browser Host when spaOriginFromRequest is on.
# Prefer one host for local work. localhost ↔ 127.0.0.1 both work after bindRedirects
# rebinds same-port loopback aliases; keep clientId in sync with registered-apps.json.
CONTROL_CONSOLE_PUBLIC_URL=http://localhost:3050
CONTROL_CONSOLE_IDP_ISSUER=http://localhost:3001/oidc
# From identity/registered-apps.json after `pnpm id:register` — SPA public client id only.
CONTROL_CONSOLE_IDP_CLIENT_ID=
CONTROL_CONSOLE_IDP_AUDIENCE=https://entitlement.luminaryworks.dev
CONTROL_CONSOLE_IDP_SCOPES=openid profile email offline_access entitlement:admin
CONTROL_CONSOLE_ENTITLEMENT_BASE_URL=http://127.0.0.1:3040
# Same-origin SPA experience (or Auth Gateway on another port). Do not mix localhost
# with 127.0.0.1 here unless you rely on bindRedirects loopback alias rebinding.
CONTROL_CONSOLE_AUTH_EXPERIENCE_URL=http://localhost:3050
CONTROL_CONSOLE_LEGAL_DOCS_URL=https://docs.luminaryworks.dev/legal
# Optional probes. Leave empty → UI shows "not configured". Do not invent HA.
CONTROL_CONSOLE_CAPACITY_DORIS_URL=
CONTROL_CONSOLE_CAPACITY_STORAGE_URL=
