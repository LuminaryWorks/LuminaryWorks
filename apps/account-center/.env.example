# Runtime config for the Account Center. Copy to `.env` for Rsbuild dev.
# Never put client secrets, service keys, or provider credentials here.

ACCOUNT_CENTER_PORT=3060
# Register both hosts in identity/apps.json. The SPA rebinds redirects to the live origin.
ACCOUNT_CENTER_PUBLIC_URL=http://localhost:3060
ACCOUNT_CENTER_IDP_ISSUER=http://localhost:3001/oidc
# Public SPA client id from identity/registered-apps.json after the lead runs `pnpm id:register`.
ACCOUNT_CENTER_IDP_CLIENT_ID=
# Access token audience. Browser calls to AI Platform use this resource.
ACCOUNT_CENTER_IDP_AUDIENCE=https://ai.luminaryworks.dev
ACCOUNT_CENTER_IDP_SCOPES=openid profile email offline_access
ACCOUNT_CENTER_AI_BASE_URL=http://127.0.0.1:13100
ACCOUNT_CENTER_ENTITLEMENT_BASE_URL=http://127.0.0.1:3040
ACCOUNT_CENTER_AUTH_EXPERIENCE_URL=http://localhost:3060
# Logto end-user account and security pages. Password changes stay on the IdP.
ACCOUNT_CENTER_IDP_ACCOUNT_URL=http://localhost:3001
ACCOUNT_CENTER_IDP_SECURITY_URL=http://localhost:3001
# JSON array: [{ "code", "name", "url", "description" }]. Each card is an independent partner product.
# Six partner products. Lab ports from deploy/OPERATOR.md where known; SyncroBrain console is :15180.
ACCOUNT_CENTER_APPS_JSON=[{"code":"dataluminary","name":"DataLuminary","url":"https://app.dataluminary.dev","description":"Data insight"},{"code":"blockyedu","name":"BlockyEdu","url":"https://blockyedu.com","description":"Education"},{"code":"doerflow","name":"DoerFlow","url":"https://doerflow.dev","description":"Workflow"},{"code":"vistaremote","name":"VistaRemote","url":"https://remote.vistacast.dev","description":"Remote access"},{"code":"vistacast","name":"VistaCast","url":"https://vistacast.dev","description":"Vision"},{"code":"syncrobrain","name":"SyncroBrain","url":"https://syncrobrain.com","description":"Device AI OS"}]

# Baked into the login clickwrap at build time (Rsbuild PUBLIC_*).
PUBLIC_LEGAL_PLATFORM_TERMS_URL=https://luminaryworks.dev/legal/terms
PUBLIC_LEGAL_PLATFORM_PRIVACY_URL=https://luminaryworks.dev/legal/privacy
PUBLIC_LEGAL_PRODUCT_TERMS_URL=/legal/terms
PUBLIC_LEGAL_PRODUCT_PRIVACY_URL=/legal/privacy
