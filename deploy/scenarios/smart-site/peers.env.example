# Incremental overlay on agent-commerce/peers.env.example. Copy to peers.env (gitignored).
# Deep links are opened by a human in a browser — never by an API, never auto-start remote.

CONTROL_PLANE_PROJECT=lw-control
CONTROL_PLANE_EDGE_NETWORK=luminary-control-edge
CONTROL_PLANE_EDGE_NETWORK_EXTERNAL=true

# Combination DNS (containers on luminary-control-edge)
VISTAREMOTE_SERVER_URL=http://server:3000
# DataLuminary observation (container port 7084; host publish 7094 in compose.dev.yml)
DATALUMINARY_API_URL=http://datatalk:7084
HOST_DATALUMINARY_API_URL=http://127.0.0.1:7094

# Human browser (daily host ports). Token is issued by VistaRemote; APIs never hold device creds.
HOST_VISTAREMOTE_URL=http://127.0.0.1:3000
SMART_SITE_REMOTE_DEEP_LINK_TEMPLATE=http://127.0.0.1:3000/intervention/{token}?ref={sourceRef}&tenant={sourceTenantId}
VISTAREMOTE_DEEP_LINK_BASE=http://127.0.0.1:3000/intervention

# DataLuminary embed origins (iframe). Observation only — not Safety Kernel or settlement.
DATALUMINARY_EMBED_ORIGINS=http://127.0.0.1:13100,http://127.0.0.1:13200,http://127.0.0.1:13008,http://127.0.0.1:3000

# BlockyEdu playbook/course links only. Browser must not hold MQTT / device / admin credentials.
BLOCKYEDU_PLAYBOOK_BASE_URL=https://learn.blockyedu.com
