# Incremental overlay on agent-commerce. Do not start a second control plane or product DB.
WITH_CONTROL_PLANE=0
CONTROL_PLANE_PROJECT=lw-control
CONTROL_PLANE_EDGE_NETWORK=luminary-control-edge
CONTROL_PLANE_EDGE_NETWORK_EXTERNAL=true

# PRODUCT_ROOTS=vistacast=/abs/VistaCast,syncrobrain=/abs/SyncroBrain,doerflow=/abs/DoerFlow,vistaremote=/abs/VistaRemote,dataluminary=/abs/DataLuminary,blockyedu=/abs/BlockyEdu

# VistaRemote deep link is a string template. Humans click it; APIs never hold device creds.
SMART_SITE_REMOTE_DEEP_LINK_TEMPLATE=http://127.0.0.1:3000/intervention/{token}?ref={sourceRef}&tenant={sourceTenantId}

# DataLuminary embed origins (iframe). Observation only — not Safety Kernel or settlement.
DATALUMINARY_EMBED_ORIGINS=http://127.0.0.1:13100,http://127.0.0.1:13200,http://127.0.0.1:13008,http://127.0.0.1:3000

# BlockyEdu playbook/course links only. Browser must not hold MQTT / device / admin credentials.
BLOCKYEDU_PLAYBOOK_BASE_URL=https://learn.blockyedu.com
