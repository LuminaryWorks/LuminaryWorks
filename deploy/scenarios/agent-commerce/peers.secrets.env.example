# Generated locally by `pnpm peers:init`. Copy the real file to peers.secrets.env
# (gitignored) and into each product env. Do not commit filled values.
#
# HMAC CloudEvents: X-DoerFlow-Signature: sha256=<hex> plus timestamp/nonce. Per-peer secret.
# Job settlement: authorize → capture | void. Callbacks do not ack/resolve/close the source object.

SYNCROBRAIN_WEBHOOK_SECRET=
DOERFLOW_HMAC_SECRET=
DOERFLOW_INVOKE_HMAC_SECRET=
DOERFLOW_CALLBACK_HMAC_SECRET=
DOERFLOW_M2M_CLIENT_ID=
DOERFLOW_M2M_CLIENT_SECRET=
TRADING_WEBHOOK_SECRET=
