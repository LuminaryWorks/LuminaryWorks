# Sibling Inbox / callback URLs for agent-commerce.
# Copy to peers.env (gitignored). Secrets belong in peers.secrets.env (also gitignored)
# and in each *product* env — never one shared .env for six products.
#
# Combination (containers on luminary-control-edge): Docker DNS below.
# Daily laptop: use the HOST_* values (published ports). Never host.docker.internal
# inside a container.

CONTROL_PLANE_PROJECT=lw-control
CONTROL_PLANE_EDGE_NETWORK=luminary-control-edge
CONTROL_PLANE_EDGE_NETWORK_EXTERNAL=true
DOERFLOW_CONTROL_PLANE_NETWORK=luminary-control-edge
DOERFLOW_CONTROL_PLANE_NETWORK_EXTERNAL=true
CONTROL_PLANE_NETWORK=luminary-control-edge

# --- Combination (Docker DNS on luminary-control-edge) ---
ENTITLEMENT_BASE_URL=http://entitlement:3040
VISTACAST_API_URL=http://api:13100
SYNCROBRAIN_GATEWAY_URL=http://iot-gateway:13200
DOERFLOW_API_URL=http://doerflow-api:13008

# VistaCast → SyncroBrain Inbox. Replace {id} with the connection created in Console.
SYNCROBRAIN_WEBHOOK_URL=http://iot-gateway:13200/api/v1/integrations/vistacast/connections/{id}/events

# SyncroBrain → DoerFlow CloudEvents inbox
DOERFLOW_EVENTS_URL=http://doerflow-api:13008/api/v1/integrations/events

# DoerFlow → SyncroBrain settlement / task callbacks (HMAC). Must not ack/resolve/close or RPC.
DOERFLOW_CALLBACK_URL=http://iot-gateway:13200/api/v1/integrations/doerflow/callbacks

# M2M (Logto client_credentials). Audience and scopes are not secrets.
DOERFLOW_API_AUDIENCE=https://api.doerflow.local
M2M_SCOPES=integration.provider.register integration.event.submit integration.callback.read
DOERFLOW_M2M_TOKEN_URL=http://identity:3001/oidc/token

# --- Daily laptop (host ports; browsers and smoke scripts) ---
HOST_VISTACAST_API_URL=http://127.0.0.1:13100
HOST_SYNCROBRAIN_GATEWAY_URL=http://127.0.0.1:13200
HOST_DOERFLOW_API_URL=http://127.0.0.1:13008
HOST_ENTITLEMENT_URL=http://127.0.0.1:3040
HOST_SYNCROBRAIN_WEBHOOK_URL=http://127.0.0.1:13200/api/v1/integrations/vistacast/connections/{id}/events
HOST_DOERFLOW_EVENTS_URL=http://127.0.0.1:13008/api/v1/integrations/events
HOST_DOERFLOW_CALLBACK_URL=http://127.0.0.1:13200/api/v1/integrations/doerflow/callbacks
