# Optional shared control plane — leave 0 to run products with identity=external_oidc|local.
WITH_CONTROL_PLANE=0
CONTROL_PLANE_PROJECT=lw-control
CONTROL_PLANE_EDGE_NETWORK=luminary-control-edge
CONTROL_PLANE_EDGE_NETWORK_EXTERNAL=true

# Sibling product MetaRepos. Unset = ../<PascalCase> from LuminaryWorks
# (from this directory that is ../../../<PascalCase>).
# PRODUCT_ROOTS=vistacast=/abs/VistaCast,syncrobrain=/abs/SyncroBrain,doerflow=/abs/DoerFlow

# Frozen cross-product contract (secrets stay in peers.secrets.env and each product env).
# See peers.env.example for Docker DNS vs host-port Inbox URLs.
DOERFLOW_API_AUDIENCE=https://api.doerflow.local
M2M_SCOPES=integration.provider.register integration.event.submit integration.callback.read
