# LuminaryWorks control plane — copy to deploy/env/control-plane.env and fill in.
#
#   cp deploy/env/control-plane.env.example deploy/env/control-plane.env
#
# deploy/env/*.env is git-ignored. Never commit real values, and never reuse one
# env file across products: each product plane owns its own secrets.
#
# Generate strong values, e.g.:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

# ---------------------------------------------------------------------------
# Project / network / host binding
# ---------------------------------------------------------------------------
CONTROL_PLANE_PROJECT=luminary-control-plane
CONTROL_PLANE_EDGE_NETWORK=luminary-control-edge
# Loopback by default. In pilot/production put a TLS reverse proxy in front and
# publish only through it (or set 0.0.0.0 behind a firewall you control).
CONTROL_PLANE_BIND_ADDR=127.0.0.1
# Logto admin console: keep on loopback / VPN even when the OIDC port is public.
CONTROL_PLANE_ADMIN_BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------------------
# Images — pin a tag or digest for pilot/production. Preflight rejects `latest`.
# ---------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
IDENTITY_IMAGE=svhd/logto:latest
AUTH_GATEWAY_IMAGE=luminaryworks/auth-gateway:local
ENTITLEMENT_IMAGE=luminaryworks/entitlement:local
AI_PLATFORM_IMAGE=luminaryworks/ai-platform:local
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.115.1

# ---------------------------------------------------------------------------
# Identity (Logto)
# ---------------------------------------------------------------------------
IDENTITY_DB_USER=logto
IDENTITY_DB_NAME=logto
IDENTITY_DB_PASSWORD=
IDENTITY_PORT=3001
IDENTITY_ADMIN_PORT=3002
# Browser-reachable URLs. Must match what SPAs and the Auth Gateway use.
IDENTITY_ENDPOINT=http://localhost:3001
IDENTITY_ADMIN_ENDPOINT=http://localhost:3002

# ---------------------------------------------------------------------------
# Auth Gateway
# ---------------------------------------------------------------------------
AUTH_GATEWAY_PORT=3010
AUTH_GATEWAY_PUBLIC_URL=http://localhost:3010
# Internal Compose DNS name — never host.docker.internal.
AUTH_GATEWAY_UPSTREAM_ISSUER=http://identity:3001/oidc
# `/ready` probes the upstream discovery document when 1.
AUTH_GATEWAY_READY_UPSTREAM=1
# Comma-separated SPA origins. Leave empty to keep the built-in dev list.
AUTH_GATEWAY_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Control Console (business superadmin SPA — not Logto Admin on :3002)
# ---------------------------------------------------------------------------
CONTROL_CONSOLE_IMAGE=luminaryworks/control-console:local
CONTROL_CONSOLE_PORT=3050
# Browser-reachable origin (TLS hostname in production).
CONTROL_CONSOLE_PUBLIC_URL=http://localhost:3050
CONTROL_CONSOLE_IDP_ISSUER=http://localhost:3001/oidc
# Public SPA client id from identity/registered-apps.json. Never a client secret.
CONTROL_CONSOLE_IDP_CLIENT_ID=
CONTROL_CONSOLE_IDP_SCOPES=openid profile email offline_access entitlement:admin
CONTROL_CONSOLE_ENTITLEMENT_BASE_URL=http://localhost:3040
CONTROL_CONSOLE_AUTH_EXPERIENCE_URL=http://localhost:3050
CONTROL_CONSOLE_CAPACITY_DORIS_URL=
CONTROL_CONSOLE_CAPACITY_STORAGE_URL=
CONTROL_CONSOLE_GIT_SHA=

# Comma-separated SPA origins allowed to call Entitlement from a browser.
# Empty = CORS closed (production default). Lab: http://localhost:3050,http://127.0.0.1:3050
ENTITLEMENT_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Entitlement
# ---------------------------------------------------------------------------
ENTITLEMENT_DB_USER=entitlement
ENTITLEMENT_DB_NAME=entitlement
ENTITLEMENT_DB_PASSWORD=
ENTITLEMENT_PORT=3040
ENTITLEMENT_NODE_ENV=production
# `oidc` is the only auth mode for a shared control plane.
ENTITLEMENT_AUTH_MODE=oidc
# Canonical upstream issuer for JWT validation (not the gateway URL).
ENTITLEMENT_OIDC_ISSUER=http://identity:3001/oidc
ENTITLEMENT_OIDC_AUDIENCE=https://entitlement.luminaryworks.dev
# Service-to-service key for product adapters.
ENTITLEMENT_SERVICE_API_KEY=
ENTITLEMENT_PARTNER_SECRET_PEPPER=
ENTITLEMENT_PARTNER_TOKEN_SECRET=
# Offline License verification: PUBLIC keys only, JSON keyed by kid.
ENTITLEMENT_LICENSE_PUBLIC_KEYS=
# Reported by GET /version.
ENTITLEMENT_GIT_SHA=
# Current legal bundle; Trial ensure requires this accept. Not legal advice.
ENTITLEMENT_LEGAL_POLICY_VERSION=lw-legal-v2026-09-07
ENTITLEMENT_LEGAL_PUBLIC_BASE_URL=https://docs.luminaryworks.dev/legal
# JSON map of productCode → { url, secret }. Placeholders only; never commit real secrets.
# BlockyEdu has one coordinator target: edu-server (not code-server).
# Example (do not use these values):
# {"blockyedu":{"url":"http://edu-server:13002/api/v1/internal/trial-purge","secret":"replace-with-hmac-secret"},"vistaremote":{"url":"http://server:3000/internal/trial-purge","secret":"replace-with-hmac-secret"}}
ENTITLEMENT_TRIAL_PURGE_TARGETS={}

# Payment credential envelope key (32-byte hex). Required in production when
# any payment provider config is enabled. Never put live Alipay/PayPal secrets here.
PAYMENT_CONFIG_MASTER_KEY=
PAYMENT_TRUSTED_PROXIES=
PAYMENT_GEO_DEFAULT_COUNTRY=
PAYMENT_MARKET_POLICY=hosted


# Optional npm registry for image builds (CN lab / air-gapped mirror).
NPM_REGISTRY=https://registry.npmjs.org

# ---------------------------------------------------------------------------
# Optional profile: ai  (dev / lab only — see spec/composable-deployment.md)
# ---------------------------------------------------------------------------
AI_PLATFORM_PORT=13100
AI_VAULT_MASTER_KEY=

# ---------------------------------------------------------------------------
# Optional profile: observability
# ---------------------------------------------------------------------------
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# ---------------------------------------------------------------------------
# Optional profile: object-storage (Hosted SaaS AIStor Free — NOT in offline packs)
#
# Official image: quay.io/minio/aistor/minio  (never minio/minio CE, never latest)
# Obtain the license yourself; do not commit it; packs must not redistribute it.
# Enable with:
#   docker compose --env-file deploy/env/control-plane.env \
#     -f deploy/compose/control-plane.yaml \
#     -f deploy/compose/control-plane.object-storage.yaml \
#     --profile object-storage up -d
# Docs: deploy/object-storage/README.md
# ---------------------------------------------------------------------------
OBJECT_STORAGE_ENABLED=0
# Placeholder only — preflight FAILS until you replace both with a tag or
# digest you confirmed on https://quay.io/repository/minio/aistor/minio?tab=tags
# (and the matching mc image). Never latest. Do not copy an unverified RELEASE.
AISTOR_MINIO_IMAGE=quay.io/minio/aistor/minio:REPLACE_WITH_CONFIRMED_QUAY_RELEASE_OR_DIGEST
AISTOR_MC_IMAGE=quay.io/minio/aistor/mc:REPLACE_WITH_CONFIRMED_QUAY_RELEASE_OR_DIGEST
AISTOR_LICENSE_FILE=/etc/luminaryworks/aistor/minio.license
AISTOR_API_PORT=9000
AISTOR_CONSOLE_PORT=9001
AISTOR_ROOT_USER=
AISTOR_ROOT_PASSWORD=
# Hard bucket quotas (GiB). Defaults sum to 120; Vista recordings get 40+40.
# Preflight fails if the sum exceeds AISTOR_BUDGET_GIB.
AISTOR_BUDGET_GIB=120
AISTOR_QUOTA_LUMINARY_MEDIA_GIB=8
AISTOR_QUOTA_DATALUMINARY_MEDIA_GIB=10
AISTOR_QUOTA_BLOCKYEDU_MEDIA_GIB=8
AISTOR_QUOTA_VISTAREMOTE_RECORDINGS_GIB=40
AISTOR_QUOTA_VISTACAST_RECORDINGS_GIB=40
AISTOR_QUOTA_BACKUP_STAGING_GIB=14
# Least-privilege product/platform keys — never copy AISTOR_ROOT_* into product env.
AISTOR_LUMINARY_ACCESS_KEY=
AISTOR_LUMINARY_SECRET_KEY=
AISTOR_DATALUMINARY_ACCESS_KEY=
AISTOR_DATALUMINARY_SECRET_KEY=
AISTOR_BLOCKYEDU_ACCESS_KEY=
AISTOR_BLOCKYEDU_SECRET_KEY=
AISTOR_VISTAREMOTE_ACCESS_KEY=
AISTOR_VISTAREMOTE_SECRET_KEY=
AISTOR_VISTACAST_ACCESS_KEY=
AISTOR_VISTACAST_SECRET_KEY=
AISTOR_BACKUP_ACCESS_KEY=
AISTOR_BACKUP_SECRET_KEY=

# ---------------------------------------------------------------------------
# Local debugging only (control-plane.dev-ports.yaml)
# ---------------------------------------------------------------------------
IDENTITY_DB_PORT=5433
IDENTITY_REDIS_PORT=6381
ENTITLEMENT_DB_PORT=5434
