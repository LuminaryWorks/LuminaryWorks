# LuminaryWorks control plane — copy to deploy/env/control-plane.env and fill in.
#
#   cp deploy/env/control-plane.env.example deploy/env/control-plane.env
#
# deploy/env/*.env is git-ignored. Never commit real values, and never reuse one
# env file across products: each product plane owns its own secrets.
#
# Generate strong values, e.g.:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

# ---------------------------------------------------------------------------
# Project / network / host binding
# ---------------------------------------------------------------------------
CONTROL_PLANE_PROJECT=luminary-control-plane
CONTROL_PLANE_EDGE_NETWORK=luminary-control-edge
# Loopback by default. In pilot/production put a TLS reverse proxy in front and
# publish only through it (or set 0.0.0.0 behind a firewall you control).
CONTROL_PLANE_BIND_ADDR=127.0.0.1
# Logto admin console: keep on loopback / VPN even when the OIDC port is public.
CONTROL_PLANE_ADMIN_BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------------------
# Images — pin a tag or digest for pilot/production. Preflight rejects `latest`.
# ---------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
IDENTITY_IMAGE=svhd/logto:latest
AUTH_GATEWAY_IMAGE=luminaryworks/auth-gateway:local
ENTITLEMENT_IMAGE=luminaryworks/entitlement:local
AI_PLATFORM_IMAGE=luminaryworks/ai-platform:local
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.115.1

# ---------------------------------------------------------------------------
# Identity (Logto)
# ---------------------------------------------------------------------------
IDENTITY_DB_USER=logto
IDENTITY_DB_NAME=logto
IDENTITY_DB_PASSWORD=
IDENTITY_PORT=3001
IDENTITY_ADMIN_PORT=3002
# Browser-reachable URLs. Must match what SPAs and the Auth Gateway use.
IDENTITY_ENDPOINT=http://localhost:3001
IDENTITY_ADMIN_ENDPOINT=http://localhost:3002

# ---------------------------------------------------------------------------
# Auth Gateway
# ---------------------------------------------------------------------------
AUTH_GATEWAY_PORT=3010
AUTH_GATEWAY_PUBLIC_URL=http://localhost:3010
# Internal Compose DNS name — never host.docker.internal.
AUTH_GATEWAY_UPSTREAM_ISSUER=http://identity:3001/oidc
# `/ready` probes the upstream discovery document when 1.
AUTH_GATEWAY_READY_UPSTREAM=1
# Comma-separated SPA origins. Leave empty to keep the built-in dev list.
AUTH_GATEWAY_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Entitlement
# ---------------------------------------------------------------------------
ENTITLEMENT_DB_USER=entitlement
ENTITLEMENT_DB_NAME=entitlement
ENTITLEMENT_DB_PASSWORD=
ENTITLEMENT_PORT=3040
ENTITLEMENT_NODE_ENV=production
# `oidc` is the only auth mode for a shared control plane.
ENTITLEMENT_AUTH_MODE=oidc
# Canonical upstream issuer for JWT validation (not the gateway URL).
ENTITLEMENT_OIDC_ISSUER=http://identity:3001/oidc
ENTITLEMENT_OIDC_AUDIENCE=https://entitlement.luminaryworks.dev
# Service-to-service key for product adapters.
ENTITLEMENT_SERVICE_API_KEY=
ENTITLEMENT_PARTNER_SECRET_PEPPER=
ENTITLEMENT_PARTNER_TOKEN_SECRET=
# Offline License verification: PUBLIC keys only, JSON keyed by kid.
ENTITLEMENT_LICENSE_PUBLIC_KEYS=
# Reported by GET /version.
ENTITLEMENT_GIT_SHA=

# ---------------------------------------------------------------------------
# Optional profile: ai  (dev / lab only — see spec/composable-deployment.md)
# ---------------------------------------------------------------------------
AI_PLATFORM_PORT=13100
AI_VAULT_MASTER_KEY=

# ---------------------------------------------------------------------------
# Optional profile: observability
# ---------------------------------------------------------------------------
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# ---------------------------------------------------------------------------
# Local debugging only (control-plane.dev-ports.yaml)
# ---------------------------------------------------------------------------
IDENTITY_DB_PORT=5433
IDENTITY_REDIS_PORT=6381
ENTITLEMENT_DB_PORT=5434
