# Copy to .env and keep it out of git. Do not paste live application keys here.
PORT=8090
MEDIA_GATEWAY_PUBLIC_BASE=http://127.0.0.1:8090
MEDIA_EDGE_BASE=http://127.0.0.1:8091
MEDIA_EDGE_PORT=8091
MEDIA_ORIGIN_DIR=origin
MEDIA_DATA_DIR=data
MEDIA_GATEWAY_SERVICE_KEY=change-me-at-least-16
MEDIA_GATEWAY_SIGNING_SECRET=change-me-at-least-16
MEDIA_SESSION_TTL_SEC=1200
# Set only when a trusted proxy (Cloudflare) is in front of the gateway.
MEDIA_TRUST_PROXY=0
# Optional. Unset uses the local file store. Keys never go in the bucket.
# REDIS_URL=redis://127.0.0.1:6379
# Edge / pack only. The gateway process does not read these.
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET=
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
