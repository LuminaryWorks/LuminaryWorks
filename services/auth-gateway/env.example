# Auth Gateway local defaults
AUTH_GATEWAY_PORT=3010
AUTH_GATEWAY_PUBLIC_URL=http://localhost:3010
# Swap to Auth0 / Keycloak / Cognito / customer IdP without changing products
UPSTREAM_ISSUER=http://localhost:3001/oidc
# Optional for non-standard provider discovery routes (comma-separated)
# AUTH_GATEWAY_DISCOVERY_PATHS=/oidc,/oidc/.well-known/openid-configuration
