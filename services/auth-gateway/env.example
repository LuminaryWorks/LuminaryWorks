# Auth Gateway local defaults
AUTH_GATEWAY_PORT=3010
AUTH_GATEWAY_PUBLIC_URL=http://localhost:3010
# Swap to Auth0 / Keycloak / Cognito / customer IdP without changing products
UPSTREAM_ISSUER=http://localhost:3001/oidc
# Optional for non-standard provider discovery routes (comma-separated)
# AUTH_GATEWAY_DISCOVERY_PATHS=/oidc,/oidc/.well-known/openid-configuration

# --- Self-register abuse (Experience Register) ---
# Editable policy file (recommended): LuminaryWorks/identity/register-email-policy.json
# AUTH_REGISTER_POLICY_FILE=/absolute/or/relative/path.json
# AUTH_REGISTER_POLICY_HOT_RELOAD=1
# AUTH_REGISTER_ABUSE_GUARD=0
# Env overrides file when set:
# AUTH_REGISTER_EMAIL_MODE=allowlist
# AUTH_REGISTER_EMAIL_ALLOWLIST=gmail.com,qq.com,outlook.com,163.com,acme.com
# AUTH_REGISTER_EMAIL_BLOCKLIST=mailinator.com,yopmail.com
# AUTH_REGISTER_IP_DAILY_LIMIT=5
# AUTH_REGISTER_CODE_IP_HOURLY_LIMIT=10
# Public read: GET /api/register-policy
