# Copy to `.env` locally (gitignored). Do not commit secrets.
#
# Data plane: shared control-plane Postgres (one instance, four databases) on 127.0.0.1:5433.
#   pnpm ent:up   # or: node scripts/control-plane-db.mjs up
# Password MUST match NOTIFICATION_DB_PASSWORD in deploy/env/control-plane.env

NOTIFICATION_PORT=3055
NOTIFICATION_DATABASE_URL=postgres://notification:CHANGE_ME@127.0.0.1:5433/notification
NOTIFICATION_SERVICE_KEY=dev-notification-service-key-change-me
NOTIFICATION_SECRET_KEY=dev-notification-secret-key-change-me
NOTIFICATION_MIGRATIONS_RUN=true
EMAIL_AUTH_ENABLED=1
MAIL_FROM=auth@luminaryworks.dev
MAIL_FROM_NAME=LuminaryWorks

# Optional: host SMTP (Maddy) then API fallbacks — see control-plane.env.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=false
SMTP_TLS_SERVERNAME=
RESEND_API_KEY=
BREVO_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
