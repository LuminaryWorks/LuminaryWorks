PORT=13100
# Shared control-plane Postgres. pnpm ent:up publishes 127.0.0.1:5433.
# Password MUST match AI_PLATFORM_DB_PASSWORD in deploy/env/control-plane.env.
AI_PLATFORM_DATABASE_URL=postgres://ai_platform:CHANGE_ME@127.0.0.1:5433/ai_platform
AI_VAULT_MASTER_KEY=
# 32-byte hex or base64. Required to store provider secrets.
AI_PLATFORM_DATA_DIR=./data
# Optional ops cost rates in minor units, e.g. {"sttPerAudioSecMinor":1,"ttsPerAudioSecMinor":2,"llmPer1kTokensMinor":3}
AI_VOICE_COST_RATES=

# Service credentials are bound to productCode. A request productCode outside the
# credential's list is 403 FORBIDDEN; a missing productCode on inference is 400.
#
# Single credential (compatible with the original key):
# AI_PLATFORM_SERVICE_API_KEY=
# AI_PLATFORM_SERVICE_PRODUCT_CODES=dataluminary,blockyedu
# AI_PLATFORM_SERVICE_INTERNAL=false
#
# Additional credentials, or several keys without the single-key variables.
# internal:true is required for POST /v1/internal/credits/grant|revoke and rate cards.
# The same key string must not appear twice. Do not commit real keys.
# AI_PLATFORM_SERVICE_CREDENTIALS_JSON=[{"key":"...","productCodes":["dataluminary"]},{"key":"...","productCodes":["luminaryworks"],"internal":true}]

# Hosted reserve/settle. Default false so lab calls keep working before grants exist.
# AI_PLATFORM_WALLET_ENFORCE=false

