{
  "name": "@luminaryworks/entitlement-service",
  "version": "0.1.0",
  "private": true,
  "license": "Polyform-Noncommercial-1.0.0",
  "description": "LuminaryWorks central subscription and entitlement service",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "biome check src test",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "license:gen-keys": "ts-node -r tsconfig-paths/register src/cli/license-issuer.ts gen-keys",
    "license:issue": "ts-node -r tsconfig-paths/register src/cli/license-issuer.ts issue",
    "license:verify": "ts-node -r tsconfig-paths/register src/cli/license-issuer.ts verify"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.55.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "@luminaryworks/notification": "^0.2.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.3",
    "@okxweb3/x402-core": "^0.1.0",
    "@okxweb3/x402-evm": "^0.2.1",
    "@okxweb3/x402-fastify": "^0.1.1",
    "bitpay-sdk": "8.0.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "5.11.3",
    "jose": "^6.2.4",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^22.6.1",
    "typeorm": "^0.3.27",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3"
  }
}
