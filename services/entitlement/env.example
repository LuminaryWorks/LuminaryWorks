# Copy to `.env` locally (gitignored). Do not commit secrets.
ENTITLEMENT_PORT=3040
ENTITLEMENT_DB_PORT=5434
ENTITLEMENT_DB_PASSWORD=entitlement_dev
ENTITLEMENT_DATABASE_URL=postgres://entitlement:entitlement_dev@localhost:5434/entitlement
ENTITLEMENT_AUTH_MODE=legacy
ENTITLEMENT_LEGACY_JWT_SECRET=dev-entitlement-secret-change-me
ENTITLEMENT_SERVICE_API_KEY=dev-service-key-change-me
ENTITLEMENT_ADMIN_SCOPES=entitlement:admin
ENTITLEMENT_OIDC_ISSUER=http://localhost:3001/oidc
ENTITLEMENT_OIDC_AUDIENCE=https://entitlement.luminaryworks.dev
ENTITLEMENT_CACHE_TTL_SECONDS=60
ENTITLEMENT_OFFLINE_GRACE_SECONDS=0
# Prefer migrations. synchronize defaults off when MIGRATIONS_RUN=true or NODE_ENV=production.
ENTITLEMENT_MIGRATIONS_RUN=false
ENTITLEMENT_SYNCHRONIZE=false

# Partner M2M (OAuth2 client_credentials)
ENTITLEMENT_PARTNER_SECRET_PEPPER=
ENTITLEMENT_PARTNER_TOKEN_SECRET=
ENTITLEMENT_PARTNER_TOKEN_TTL_SECONDS=3600
ENTITLEMENT_PARTNER_REPLAY_WINDOW_SECONDS=300

# Ed25519 License public-key ring only (JSON object kid → SPKI PEM). NEVER put private keys here.
# Example: {"ed25519-abc":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}
ENTITLEMENT_LICENSE_PUBLIC_KEYS=
# Issuer only (admin API / CLI). Load from secret store; do not commit.
ENTITLEMENT_LICENSE_PRIVATE_KEY=
ENTITLEMENT_LICENSE_DEFAULT_KID=

# Outbox / notifications
ENTITLEMENT_OUTBOX_POLL_MS=5000
ENTITLEMENT_OUTBOX_BATCH_SIZE=20
ENTITLEMENT_OUTBOX_MAX_ATTEMPTS=8
ENTITLEMENT_NOTIFY_EMAIL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
MAIL_FROM_OFFICIAL=

# Versioned legal acceptance (Terms / Privacy / Trial deletion). Not legal advice.
ENTITLEMENT_LEGAL_POLICY_VERSION=lw-legal-v2026-09-07
ENTITLEMENT_LEGAL_PUBLIC_BASE_URL=https://docs.luminaryworks.dev/legal

# Trial purge targets: JSON object keyed by productCode → { url, secret }.
# url must be https or internal http. Do not put real secrets here.
# Example:
# ENTITLEMENT_TRIAL_PURGE_TARGETS={"dataluminary":{"url":"http://dataluminary:8080/internal/trial-purge","secret":"replace-with-product-secret"}}
ENTITLEMENT_TRIAL_PURGE_TARGETS={}
ENTITLEMENT_TRIAL_PURGE_TIMEOUT_MS=15000

# Payment platform (provider-neutral). 32-byte hex or base64. Required in production
# when any payment_provider_configs row is enabled. Never commit live credentials.
PAYMENT_CONFIG_MASTER_KEY=
# Comma-separated proxy IPs/CIDRs allowed to inject CF-IPCountry (CDN / Caddy).
PAYMENT_TRUSTED_PROXIES=
# ISO country used when the direct peer is not a trusted proxy (no GeoIP DB yet).
PAYMENT_GEO_DEFAULT_COUNTRY=
# hosted = CN defaults to Alipay (+ optional manual); scopes_only honors config markets.
PAYMENT_MARKET_POLICY=hosted
PAYMENT_RECONCILE_PENDING_MINUTES=5
PAYMENT_CREDENTIAL_RETIRING_HOURS=48

# Browser CORS allowlist for the Control Console (comma-separated origins).
# Empty = closed (production default). Set e.g. http://localhost:3050,http://127.0.0.1:3050
ENTITLEMENT_CORS_ORIGINS=
